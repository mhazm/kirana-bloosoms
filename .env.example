# Token bot dari Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# Application ID dari Discord Developer Portal > General Information
CLIENT_ID=

# ID server Discord Nismara Transport (klik kanan server > Copy Server ID)
GUILD_ID=

# Lokasi file database SQLite
DATABASE_PATH=./data/kirana.db

# Interval cek GameMonitoring dalam detik (minimal 30)
UPDATE_INTERVAL_SECONDS=60
